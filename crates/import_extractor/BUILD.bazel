load("@rules_go//go:def.bzl", "go_test")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust_prost//:defs.bzl", "rust_prost_library")
load(":opt.bzl", "cgo_rust_library", "cgo_rust_static_library")

# proto_library lives at //proto:import_extractor_proto so that //ts/proto can
# depend on it without loading any rules_rs symbols.
rust_prost_library(
    name = "import_extractor_rust_proto",
    proto = "//proto:import_extractor_proto",
    visibility = ["//visibility:public"],
)

_LIB_SRCS = [
    "src/ffi.rs",
    "src/lib.rs",
    "src/ts.rs",
    "src/wire.rs",
]

_LIB_DEPS = [
    ":import_extractor_rust_proto",
    # Use the same prost runtime as rust_prost_library — sharing identical
    # versions across separate crate.from_cargo invocations isn't enough,
    # they're distinct repo instances and Rust treats them as different types.
    "@rules_rs//rs/private/prost:prost_runtime",
    "@gazelle_ts_crates//:oxc",
    "@gazelle_ts_crates//:oxc_allocator",
    "@gazelle_ts_crates//:oxc_ast",
    "@gazelle_ts_crates//:oxc_parser",
    "@gazelle_ts_crates//:oxc_span",
    "@gazelle_ts_crates//:rayon",
]

# rlib variant — linked through cgo by //ts and used by the unit tests.
cgo_rust_library(
    name = "import_extractor",
    srcs = _LIB_SRCS,
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

# staticlib variant used by the symbol test. This intentionally follows the
# caller's compilation mode so wildcard PR tests do not pay release opt/LTO.
cgo_rust_static_library(
    name = "import_extractor_static",
    srcs = _LIB_SRCS,
    edition = "2021",
    visibility = ["//visibility:public"],
    deps = _LIB_DEPS,
)

genrule(
    name = "ffi_symbols_nm",
    srcs = [":import_extractor_static"],
    outs = ["ffi_symbols_nm.txt"],
    cmd = "nm -g $(location :import_extractor_static) > $@ 2>&1 || true",
)

genrule(
    name = "ffi_symbols_check",
    srcs = [":import_extractor_static"],
    outs = ["ffi_symbols_check.txt"],
    cmd = """
set -eu
nm -g $(location :import_extractor_static) > "$@" 2>&1 || true
for symbol in gazelle_ts_ie_dispatch gazelle_ts_ie_free; do
    if ! grep -Eq "(^|[[:space:]])_?$$symbol$$" "$@"; then
        echo "missing exported symbol $$symbol in $(location :import_extractor_static)" >&2
        exit 1
    fi
done
for symbol in ie_dispatch ie_free; do
    if grep -Eq "(^|[[:space:]])_?$$symbol$$" "$@"; then
        echo "generic exported symbol $$symbol must not be present in $(location :import_extractor_static)" >&2
        exit 1
    fi
done
""",
)

rust_test(
    name = "test",
    crate = ":import_extractor",
)

go_test(
    name = "ffi_symbols_test",
    srcs = ["ffi_symbols_test.go"],
    args = ["-symbols=$(location :ffi_symbols_nm)"],
    data = [":ffi_symbols_nm"],
    importpath = "github.com/hermeticbuild/gazelle_ts/crates/import_extractor/ffi_symbols_test",
)
