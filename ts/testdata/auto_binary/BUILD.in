load("@gazelle_ts//ts:defs.bzl", "ts_binary")

ts_binary(
    name = "custom",
    entry_point = "existing.ts",
    srcs = [
        "bootstrap.js",
        "existing.ts",
    ],
)

ts_binary(
    name = "computed",
    entry_point = "computed.ts",
    srcs = select({
        "//conditions:default": ["computed.ts"],
    }),
    deps = ["//manual:dep"],
)

ts_binary(
    name = "mixed",
    srcs = ["mixed.ts", GENERATED_SRCS],
    deps = ["//manual:dep"],
)

ts_binary(
    name = "stale_bin",
    entry_point = "stale.ts",
)

ts_binary(
    name = "main_bin",
    entry_point = "main.ts",
    deps = [":lib"],
)
