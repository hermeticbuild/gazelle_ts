load("@gazelle_ts//ts:defs.bzl", "ts_library", "ts_test", "ts_visual_library")

# gazelle:ts_bundler_config_pattern vite.config.ts vite_config

filegroup(
    name = "owned",
    srcs = [
        "owned.story.tsx",
        "owned.template.ts",
        "owned.test.ts",
        "vite.config.ts",
        ":owned.ts",
    ],
)

ts_library(
    name = "lib",
    srcs = [
        "excluded.template.ts",
        "visible.ts",
    ],
    visibility = ["//visibility:public"],
)

ts_test(
    name = "test",
    srcs = ["visible.test.ts"],
    deps = [":lib"],
)

ts_visual_library(
    name = "visual_library",
    srcs = ["visible.story.tsx"],
    visibility = ["//visibility:public"],
    deps = [":lib"],
)
