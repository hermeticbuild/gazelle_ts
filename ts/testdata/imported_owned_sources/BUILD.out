load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@gazelle_ts//ts:defs.bzl", "ts_library", "ts_test")

# gazelle:ts_test_pattern setup.ts

filegroup(
    name = "runtime_sources",
    srcs = [
        "resource.ts",
        "setup.ts",
        "unused.template.ts",
    ],
)

js_binary(
    name = "cli",
    entry_point = "cli.ts",
)

ts_library(
    name = "split",
    srcs = ["split.ts"],
)

ts_library(
    name = "lib",
    srcs = [
        "app.ts",
        "cli.ts",
        "resource.ts",
    ],
    visibility = ["//visibility:public"],
    deps = [":split"],
)

ts_test(
    name = "test",
    srcs = ["app.test.ts"],
    deps = [":lib"],
)
