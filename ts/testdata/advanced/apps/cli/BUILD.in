load("//tools:ts.bzl", "myorg_ts_binary", "myorg_ts_library")

# Hand-written ts_binary. Gazelle links it to the emitted package library; the
# user owns source expressions and explicit runtime data.
myorg_ts_binary(
    name = "cli_bin",
    data = [
        "users.json",  # keep
        "//:node_modules/@myrepo_generated/synthetic",
        "//:node_modules/@types/node",
        "//packages/core",
        "//packages/utils/math/deep",
        "//tools:mystery",
    ],
    entry_point = "main.ts",
)

myorg_ts_library(
    name = "cli",
    srcs = [
        "main.ts",
        "types.d.ts",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@myrepo_generated/synthetic",
        "//:node_modules/@types/node",
        "//packages/core",
        "//packages/utils/math/deep",
        "//tools:mystery",
    ],
)
