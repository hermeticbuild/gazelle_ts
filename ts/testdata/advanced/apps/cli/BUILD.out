load("//tools:ts.bzl", "myorg_ts_binary", "myorg_ts_library")

# gazelle:exclude library.resource.ts

# Hand-written launcher. Gazelle attaches a generated private library.
myorg_ts_binary(
    name = "cli_bin",
    srcs = glob(["*.cli.ts"]),
    data = ["users.json"],
    entry_point = "main.ts",
    deps = [":cli_bin_lib"],
)

myorg_ts_binary(
    name = "platform_bin",
    data = select({
        "//conditions:default": ["platform-config.json"],
    }),
    entry_point = "platform.ts",
    deps = [":platform_bin_lib"],
)

filegroup(
    name = "templates",
    srcs = glob(
        ["*.template.ts"],
        exclude = ["excluded.template.ts"],
    ),
)

myorg_ts_library(
    name = "cli",
    srcs = [
        "excluded.template.ts",
        "types.d.ts",
    ],
    data = select({
        "//conditions:default": ["library.resource.ts"],
    }),
    visibility = ["//visibility:public"],
)

myorg_ts_library(
    name = "cli_bin_lib",
    srcs = [
        "aux.cli.ts",
        "main.ts",
        "types.d.ts",
    ],
    tags = ["gazelle_ts_binary_library"],
    tsconfig_types = ["node"],
    visibility = ["//visibility:private"],
    deps = [
        "//:node_modules/@myrepo_generated/synthetic",
        "//:node_modules/@tanstack/react-query",
        "//:node_modules/@types/node",
        "//packages/core",
        "//packages/utils/math/deep",
        "//tools:mystery",
    ],
)

myorg_ts_library(
    name = "platform_bin_lib",
    srcs = [
        "platform.ts",
        "types.d.ts",
    ],
    tags = ["gazelle_ts_binary_library"],
    tsconfig_types = ["node"],
    visibility = ["//visibility:private"],
    deps = ["//:node_modules/@types/node"],
)
