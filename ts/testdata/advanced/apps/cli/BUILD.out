load("//tools:ts.bzl", "myorg_ts_binary", "myorg_ts_library")

# Hand-written ts_binary — gazelle never generates these, but it does
# manage the `data` attr based on what entry_point/srcs imports. The user
# owns name, entry_point, env, etc.; the plugin fills in data deps.
myorg_ts_binary(
    name = "cli_bin",
    srcs = glob(["*.cli.ts"]),
    data = [
        "users.json",
        "//:node_modules/@myrepo_generated/synthetic",
        "//:node_modules/@tanstack/react-query",
        "//:node_modules/@types/node",
        "//packages/core",
        "//packages/utils/math/deep",
        "//tools:mystery",
    ],
    entry_point = "main.ts",
    tsconfig_types = ["node"],
)

myorg_ts_binary(
    name = "platform_bin",
    data = select({
        "//conditions:default": ["platform-config.json"],
    }),
    entry_point = "platform.ts",
    tsconfig_types = ["node"],
)

filegroup(
    name = "templates",
    srcs = glob(
        ["*.template.ts"],
        exclude = ["excluded.template.ts"],
    ),
)

myorg_ts_library(
    name = "cli",
    srcs = [
        "excluded.template.ts",
        "types.d.ts",
    ],
    data = select({
        "//conditions:default": ["library.resource.ts"],
    }),
    visibility = ["//visibility:public"],
)
